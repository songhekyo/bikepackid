# Copy this to .env on the server (next to docker-compose.yml) and fill in
# real values. Never commit the real .env — it's gitignored.

# Managed Postgres (e.g. Supabase), pointing at an external host — this is
# what the original VPS deploy (DEPLOY.md) used. Get this from your
# provider's dashboard; rotate the password if it's ever pasted anywhere
# outside this file (chat, issue tracker, etc).
DATABASE_URL=postgresql://postgres:change-this-password@db.your-project-ref.supabase.co:5432/postgres
#
# The AWS EC2 deploy (DEPLOY_AWS.md) instead self-hosts Postgres as a
# container via docker-compose.postgres.yml, in which case this instead
# points at the `postgres` service and needs a matching POSTGRES_PASSWORD:
# DATABASE_URL=postgres://bikepackid:<POSTGRES_PASSWORD>@postgres:5432/bikepackid
# POSTGRES_PASSWORD=change-this-generate-with-openssl-rand-hex-24

# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string

# From Google Cloud Console (console.cloud.google.com/apis/credentials).
# GOOGLE_REDIRECT_URL must exactly match a redirect URI registered there.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URL=https://your-domain/auth/google/callback

FRONTEND_URL=https://your-domain
PORT=8080

# Default (true) is correct once HTTPS is live (nginx + certbot — see
# DEPLOY_AWS.md). Only set false for local dev over plain HTTP.
# COOKIE_SECURE=false

RUST_LOG=info
LOG_FORMAT=json

# Cloudflare R2 — see docs/JOURNEY_TODO.md "Task 0" for how these were
# provisioned (bucket + scoped Account API Token). Rotate if ever pasted
# anywhere outside this file, same as DATABASE_URL above.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=bikepackid-media
R2_PUBLIC_URL_BASE=https://pub-xxxxxxxx.r2.dev

# Points at the local Alloy collector (docker-compose service `alloy`),
# not Grafana Cloud directly — Alloy holds the Grafana Cloud credentials
# and forwards, so auth-service itself never needs them. Leave unset to
# disable trace export entirely (e.g. local dev without Alloy running).
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318

# For the `alloy` service (docker-compose.yml) — from Grafana Cloud
# portal: your stack -> OpenTelemetry card -> Configure. Generate the API
# token there (shown once, save it immediately). Leave DATABASE_URL-style
# secrets like this out of anywhere but this file.
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-xxx.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=your-instance-id
GRAFANA_CLOUD_API_KEY=change-this-api-token

# AWS SES welcome email (see DEPLOY_AWS.md "Email transaksional (AWS SES)").
# No AWS keys belong in this file — credentials come from the IAM role
# attached to the EC2 instance itself, and the region from IMDS, both
# resolved automatically by the AWS SDK's default provider chain.
#
# Expo Go link for the mobile app once it exists. Leave unset until then —
# the welcome email is skipped entirely while this is unset, so merging
# the SES integration ahead of the app can't ever send a broken link.
APP_INSTALL_URL=exp://u.expo.dev/your-project-id
