JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
FRONTEND_URL=
PORT=
# Session cookies require HTTPS by default. Only set this to false for
# local development over plain HTTP — never in production.
COOKIE_SECURE=false

# Log verbosity (standard tracing/env_logger syntax), e.g. debug,
# info,tower_http=debug, etc. Defaults to "info" if unset.
RUST_LOG=info,opentelemetry_otlp=debug,opentelemetry_sdk=debug,reqwest=trace,hyper=trace,hyper_util=trace

# "json" for structured logs any log shipper (Filebeat/Vector for ELK,
# Datadog Agent, Fluent Bit, ...) can parse off stdout. Leave unset for
# human-readable logs in local dev.
# LOG_FORMAT=json

# OTLP/HTTP endpoint of an OpenTelemetry Collector to export traces to
# (e.g. http://localhost:4318). Works with Kibana/Elastic APM, Datadog,
# Grafana Tempo, Jaeger, Honeycomb, etc. — anything that speaks OTLP.
# Leave unset to disable trace export (default; no collector needed for
# local dev).

OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=
POSTGRES_PASSWORD=
DATABASE_URL=

# Expo Go link for the mobile app (e.g. an `exp://` or published
# `https://u.expo.dev/...` URL). Leave unset until that project exists —
# the welcome email is skipped entirely while this is unset, never sent
# with a broken link.
APP_INSTALL_URL=

# Scopes the session cookie across subdomains (e.g. taktikdansiasat.com) so
# a separate service on a subdomain can read the same login via a shared
# JWT_SECRET. Leave unset for local dev — a cookie scoped to a real domain
# is never sent to localhost.
COOKIE_DOMAIN=
