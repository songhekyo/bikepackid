DATABASE_URL=postgres://bikepackid:bikepackid_dev@localhost:5432/bikepackid
JWT_SECRET=change-this-to-a-long-random-string
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
FRONTEND_URL=http://localhost:3000
PORT=8080
# Session cookies require HTTPS by default. Only set this to false for
# local development over plain HTTP — never in production.
COOKIE_SECURE=false

# Cloudflare R2 — object storage for uploaded photos (journey cover
# images, checkpoint/post photos). See docs/JOURNEY_TODO.md "Task 0" for
# how to provision the bucket + credentials. Required even locally: the
# backend won't start without these (same as the other credentials above),
# though nothing breaks until you actually hit /uploads/presign-url.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=bikepackid-media
R2_PUBLIC_URL_BASE=https://pub-xxxxxxxx.r2.dev

# Log verbosity (standard tracing/env_logger syntax), e.g. debug,
# info,tower_http=debug, etc. Defaults to "info" if unset.
# RUST_LOG=info

# "json" for structured logs any log shipper (Filebeat/Vector for ELK,
# Datadog Agent, Fluent Bit, ...) can parse off stdout. Leave unset for
# human-readable logs in local dev.
# LOG_FORMAT=json

# OTLP/HTTP endpoint of an OpenTelemetry Collector to export traces to
# (e.g. http://localhost:4318). Works with Kibana/Elastic APM, Datadog,
# Grafana Tempo, Jaeger, Honeycomb, etc. — anything that speaks OTLP.
# Leave unset to disable trace export (default; no collector needed for
# local dev).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
