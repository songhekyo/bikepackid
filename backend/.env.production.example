# Copy this to .env on the VPS (next to docker-compose.yml) and fill in
# real values. Never commit the real .env — it's gitignored.

# Managed Postgres (e.g. Supabase) — no local postgres container in
# docker-compose.yml, so this points at an external host. Get this from
# your provider's dashboard; rotate the password if it's ever pasted
# anywhere outside this file (chat, issue tracker, etc).
DATABASE_URL=postgresql://postgres:change-this-password@db.your-project-ref.supabase.co:5432/postgres

# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string

# From Google Cloud Console (console.cloud.google.com/apis/credentials).
# GOOGLE_REDIRECT_URL must exactly match a redirect URI registered there.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URL=http://YOUR_SERVER_IP:8080/auth/google/callback

FRONTEND_URL=http://YOUR_SERVER_IP:8080
PORT=8080

# No frontend/HTTPS yet (Phase 1) — set false so the login cookie actually
# gets set over plain HTTP. Switch to true (or just remove this line; true
# is the default) once Caddy + a real domain are in place (Phase 2).
COOKIE_SECURE=false

RUST_LOG=info
LOG_FORMAT=json

# Leave unset until you wire up a collector (see README.md Observability).
# OTEL_EXPORTER_OTLP_ENDPOINT=
